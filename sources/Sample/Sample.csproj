<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(StandardTargetFramework);$(StandardTargetFramework)-android;$(StandardTargetFramework)-ios;$(StandardTargetFramework)-maccatalyst</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Zenith.NET.Views" />
    </ItemGroup>

    <Choose>
        <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
            <ItemGroup>
                <PackageReference Include="Zenith.NET.Vulkan" />
            </ItemGroup>
        </When>

        <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
            <ItemGroup>
                <PackageReference Include="Zenith.NET.Metal" />
            </ItemGroup>
        </When>

        <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
            <ItemGroup>
                <PackageReference Include="Zenith.NET.Metal" />
            </ItemGroup>
        </When>

        <Otherwise>
            <ItemGroup>
                <PackageReference Include="Zenith.NET.DirectX12" />
            </ItemGroup>
        </Otherwise>
    </Choose>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
        <None Include="Shaders\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
